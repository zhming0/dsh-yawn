{
  "name": "@zhming0/dsh-yawn",
  "version": "0.1.0",
  "description": "Remote sandbox lifecycle and control plane for DeepSeek Harness",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhming0/dsh-yawn.git",
    "directory": "control-plane"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fs": {
      "types": "./dist/sandbox/fs.d.ts",
      "default": "./dist/sandbox/fs.js"
    },
    "./shell": {
      "types": "./dist/sandbox/shell.d.ts",
      "default": "./dist/sandbox/shell.js"
    },
    "./subprocess": {
      "types": "./dist/sandbox/subprocess.d.ts",
      "default": "./dist/sandbox/subprocess.js"
    },
    "./file-reference": {
      "types": "./dist/workspaces/file-reference.d.ts",
      "default": "./dist/workspaces/file-reference.js"
    },
    "./forge-credentials": {
      "types": "./dist/credentials/forge-credentials.d.ts",
      "default": "./dist/credentials/forge-credentials.js"
    },
    "./skills": {
      "types": "./dist/skills.d.ts",
      "default": "./dist/skills.js"
    },
    "./mcp-tool-exclusion": {
      "types": "./dist/mcp/mcp-tool-exclusion.d.ts",
      "default": "./dist/mcp/mcp-tool-exclusion.js"
    },
    "./session-tools": {
      "types": "./dist/sessions/session-tools.d.ts",
      "default": "./dist/sessions/session-tools.js"
    },
    "./creator-bundles": {
      "types": "./dist/creator/bundles.d.ts",
      "default": "./dist/creator/bundles.js"
    },
    "./plugin-source": {
      "types": "./dist/creator/source.d.ts",
      "default": "./dist/creator/source.js"
    },
    "./sandbox-context": {
      "types": "./dist/sandbox/sandbox-context.d.ts",
      "default": "./dist/sandbox/sandbox-context.js"
    },
    "./sandbox-policy": {
      "types": "./dist/sandbox/sandbox-policy.d.ts",
      "default": "./dist/sandbox/sandbox-policy.js"
    },
    "./workspace-files": {
      "types": "./dist/workspaces/workspace-files.d.ts",
      "default": "./dist/workspaces/workspace-files.js"
    },
    "./working-directory": {
      "types": "./dist/sandbox/working-directory.d.ts",
      "default": "./dist/sandbox/working-directory.js"
    },
    "./terminal-controller": {
      "types": "./dist/terminal/terminal-controller.d.ts",
      "default": "./dist/terminal/terminal-controller.js"
    },
    "./media-route": {
      "types": "./dist/media/media-route.d.ts",
      "default": "./dist/media/media-route.js"
    },
    "./video-route": {
      "types": "./dist/media/video-route.d.ts",
      "default": "./dist/media/video-route.js"
    },
    "./passcode-auth": {
      "types": "./dist/auth/passcode-auth.d.ts",
      "default": "./dist/auth/passcode-auth.js"
    },
    "./oidc-auth": {
      "types": "./dist/auth/oidc-auth.d.ts",
      "default": "./dist/auth/oidc-auth.js"
    },
    "./scratch-workspace": {
      "types": "./dist/workspaces/scratch-workspace.d.ts",
      "default": "./dist/workspaces/scratch-workspace.js"
    },
    "./workspace-first-use": {
      "types": "./dist/workspaces/workspace-first-use.d.ts",
      "default": "./dist/workspaces/workspace-first-use.js"
    },
    "./owns-host": {
      "types": "./dist/owns-host.d.ts",
      "default": "./dist/owns-host.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "dist",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "prepack": "tsc -p tsconfig.build.json && tsdown && node scripts/copy-skill-bodies.mjs",
    "build": "tsc -p tsconfig.build.json && tsdown && node scripts/copy-skill-bodies.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,md}' 'tests/**/*.ts' '*.ts' '*.md'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,md}' 'tests/**/*.ts' '*.ts' '*.md'",
    "test": "vitest run"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.14.0",
    "@connectrpc/connect": "2.1.2",
    "@connectrpc/connect-node": "2.1.2",
    "@deepseek-ai/dsh-fs-patch": "0.2.2-rc.1",
