#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "$0")/lib/mise.bash"
ensure_tools go "aqua:golangci/golangci-lint"

cd runner

echo "--- :golang: Restoring the Go cache"
buildkite-agent cache restore --name go

echo "--- :golang: Linting"
golangci-lint run

echo "--- :hammer: Building"
go build ./...

echo "+++ :golang: Running tests"
go test -race ./...

# go stores module cache contents read-only; make them archivable.
chmod -R u+w "$HOME/go/pkg/mod"
buildkite-agent cache save --name go
