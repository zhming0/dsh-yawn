#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "$0")/lib/mise.bash"
ensure_tools node

echo "--- :docker: Building the runner image"
docker buildx bake dev --load

echo "--- :pnpm: Installing dependencies"
buildkite-agent cache restore --name pnpm
pnpm install --frozen-lockfile
buildkite-agent cache save --name pnpm

echo "--- :package: Building the control plane"
pnpm build

echo "+++ :docker: Running the lifecycle smoke test"
DSH_YAWN_RUNNER_IMAGE="dsh-yawn-runner:dev" pnpm test:docker
