#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "$0")/lib/mise.bash"
ensure_tools "github:cli/cli"

VERSION="$(buildkite-agent meta-data get release-version)"
TAG="$VERSION"
# package-and-push-chart recorded the commit the build started from. No release
# step writes a commit to `main`, so the tag names the commit that was built.
RELEASE_COMMIT="$(buildkite-agent meta-data get release-commit)"
CONTROL_PLANE_IMAGE="ghcr.io/zhming0/dsh-yawn-control-plane"
RUNNER_IMAGE="ghcr.io/zhming0/dsh-yawn-runner"

# The release skill prepends a short highlight to this note. Keep the template
# factual and short: images and the pool pin. GitHub's generated change list
# goes above it, and the full-changelog link stays last.
NOTES="$(cat <<'EOF'
## 📦 Images

```sh
docker pull __CONTROL_PLANE_IMAGE__:__VERSION__
docker pull __RUNNER_IMAGE__:__VERSION__
```

## 🧱 Kubernetes sandbox pool

Pin the base and its runner image in `kustomization.yaml`:

```yaml
resources:
  - https://github.com/zhming0/dsh-yawn//deploy/kubernetes/runner?ref=__TAG__
images:
  - name: __RUNNER_IMAGE__
    newTag: __VERSION__
```

Apply from the overlay directory:

```sh
kubectl apply -k .
```

Docker and Buildkite use the runner image automatically. [Kubernetes runner
guide](https://github.com/zhming0/dsh-yawn/blob/__TAG__/docs/runners/kubernetes.md)
EOF
)"

NOTES="${NOTES//__CONTROL_PLANE_IMAGE__/$CONTROL_PLANE_IMAGE}"
NOTES="${NOTES//__RUNNER_IMAGE__/$RUNNER_IMAGE}"
NOTES="${NOTES//__VERSION__/$VERSION}"
NOTES="${NOTES//__TAG__/$TAG}"

# `gh release create` appends generated notes after --notes, so fetch the
# generated body first and place it above the image and pool sections.
GENERATED="$(gh api --method POST "repos/zhming0/dsh-yawn/releases/generate-notes" \
  -f tag_name="$TAG" \
  -f target_commitish="$RELEASE_COMMIT" \
  --jq .body)"
CHANGES="$(printf '%s\n' "$GENERATED" | sed '/^\*\*Full Changelog\*\*:/,$d')"
FULL_CHANGELOG="$(printf '%s\n' "$GENERATED" | sed -n '/^\*\*Full Changelog\*\*:/,$p')"

echo "+++ :github: Creating GitHub release"
# --target creates the tag at the commit the build started from, which is what
# the images and the chart were built and published from.
gh release create "$TAG" --target "$RELEASE_COMMIT" --title "$TAG" --notes "${CHANGES}

${NOTES}

${FULL_CHANGELOG}"
