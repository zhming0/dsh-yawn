#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "$0")/lib/mise.bash"
ensure_tools node go "aqua:golangci/golangci-lint"

echo "--- :pnpm: Installing dependencies"
buildkite-agent cache restore --name pnpm
pnpm install --frozen-lockfile
buildkite-agent cache save --name pnpm

echo "--- :mag: Type check and protobuf lint"
pnpm check

echo "--- :mag: Lint"
pnpm lint

echo "--- :art: Format check"
pnpm format:check

echo "+++ :vitest: Running tests"
pnpm test

echo "--- :package: Building"
pnpm build
