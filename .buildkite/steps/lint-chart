#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "$0")/lib/mise.bash"
ensure_tools

CHART="deploy/helm/dsh-yawn"

echo "--- :helm: Linting the chart"
helm lint "$CHART" --namespace dsh-yawn --set registrationToken.value=ci-token

# Deterministic renders: `lookup` finds no cluster here, so pin the token
# instead of letting each render generate a different one.
render() {
  helm template dsh-yawn-control-plane "$CHART" --namespace dsh-yawn \
    --set registrationToken.value=ci-token "$@"
}

echo "--- :helm: Rendering the default and proxy value sets"
render >/tmp/chart-default.yaml
grep -q "DSH_YAWN_CONTROL_PLANE_LAUNCH_TOKEN_ROUTE" /tmp/chart-default.yaml \
  || { echo "default render lost the /launch-token route" >&2; exit 1; }
grep -q "ws://dsh-yawn-control-plane-tunnel.dsh-yawn.svc.cluster.local:8081/tunnel" /tmp/chart-default.yaml \
  || { echo "dsh-yawn-runner-config lost the in-cluster tunnel address" >&2; exit 1; }
render --set oidc.enabled=true --set oidc.hostname=dsh.example.com \
  --set service.type=LoadBalancer --set service.annotations.foo=bar \
  --set oidc.extraEnv[0].name=OAUTH2_PROXY_INSECURE_OIDC_ALLOW_UNVERIFIED_EMAIL \
  --set oidc.extraEnv[0].value=true >/tmp/chart-proxy.yaml
for expected in "type: LoadBalancer" "foo: bar" "OAUTH2_PROXY_INSECURE_OIDC_ALLOW_UNVERIFIED_EMAIL"; do
  grep -q "$expected" /tmp/chart-proxy.yaml \
    || { echo "proxy render lost: $expected" >&2; exit 1; }
done
# controlPlane.extraEnv is how a boot-time credential (the Buildkite API token)
# reaches the process from a Secret, so the block has to render where dsh
# reads it.
render --set controlPlane.extraEnv[0].name=BUILDKITE_API_TOKEN \
  --set controlPlane.extraEnv[0].valueFrom.secretKeyRef.name=dsh-buildkite \
  --set controlPlane.extraEnv[0].valueFrom.secretKeyRef.key=token >/tmp/chart-control-plane-env.yaml
for expected in "name: BUILDKITE_API_TOKEN" "name: dsh-buildkite"; do
  grep -q "$expected" /tmp/chart-control-plane-env.yaml \
    || { echo "controlPlane.extraEnv render lost: $expected" >&2; exit 1; }
done
# Every install names a sandbox pool through controlPlane.sandboxManager, and the
# in-cluster dev control plane (dev-cluster.sh --control-plane-image) is no
# exception. The render has to carry the settings file and the mount, or it boots
# with the seeded `profiles: {}` and cannot provision.
render --set controlPlane.sandboxManager.profiles.standard.backend=kas \
  --set controlPlane.sandboxManager.profiles.standard.warmPool=dsh-yawn-universal \
  >/tmp/chart-profile.yaml
for expected in "name: dsh-yawn-control-plane-sandbox-settings" \
  "/etc/dsh-yawn/sandbox-settings.yaml" "sandboxManager:" \
  "warmPool: dsh-yawn-universal"; do
  grep -qF "$expected" /tmp/chart-profile.yaml \
    || { echo "chart profile render lost: $expected" >&2; exit 1; }
done
# A kas profile with no namespace has to render the release namespace: the
# control plane's own default is the fixed name dsh-yawn, so a control plane installed
# elsewhere would claim in a namespace its pool is not in. `render` pins the
# dsh-yawn namespace, so this one calls helm directly.
helm template dsh-yawn-control-plane "$CHART" --namespace platform \
  --set registrationToken.value=ci-token \
  --set controlPlane.sandboxManager.profiles.standard.backend=kas \
  --set controlPlane.sandboxManager.profiles.standard.warmPool=dsh-yawn-universal \
  --show-only templates/control-plane-sandbox-settings-configmap.yaml >/tmp/chart-profile-ns.yaml
grep -qF "namespace: platform" /tmp/chart-profile-ns.yaml \
  || { echo "chart profile does not default the namespace to the release namespace" >&2; exit 1; }

# Previews: the settings section, the container port, and the Service all
# have to render, and the strip list has to reach the settings document.
render --set controlPlane.sandboxManager.profiles.standard.backend=kas \
  --set controlPlane.sandboxManager.profiles.standard.warmPool=dsh-yawn-universal \
  --set preview.domain=sandbox.example.com \
  --set 'preview.authCookieNames[0]=_front_session' >/tmp/chart-preview.yaml
for expected in 'domain: "sandbox.example.com"' "authCookieNames:" \
  "_front_session" "name: preview" "name: dsh-yawn-control-plane-preview" \
  "targetPort: preview"; do
  grep -qF "$expected" /tmp/chart-preview.yaml \
    || { echo "preview render lost: $expected" >&2; exit 1; }
done
# Without a domain, nothing preview-shaped renders.
render --set controlPlane.sandboxManager.profiles.standard.backend=kas \
  >/tmp/chart-preview-off.yaml
if grep -q "dsh-yawn-control-plane-preview\|containerPort: 8082" /tmp/chart-preview-off.yaml; then
  echo "preview resources rendered without preview.domain" >&2; exit 1
fi

echo "--- :helm: Checking the chart guards"
expect_fail() {
  local what="$1"; shift
  if helm template dsh-yawn-control-plane "$CHART" --namespace dsh-yawn "$@" >/dev/null 2>&1; then
    echo "guard failed: $what rendered successfully" >&2
    exit 1
  fi
}
# The sandbox pool reads fixed names, so the release name is part of the
# contract. `helm template` takes the name as an argument, not a flag.
if helm template other "$CHART" --namespace dsh-yawn --set registrationToken.value=x >/dev/null 2>&1; then
  echo "guard failed: a foreign release name rendered successfully" >&2; exit 1
fi
expect_fail "a kas profile in a foreign namespace" --set registrationToken.value=x \
  --set controlPlane.sandboxManager.profiles.standard.backend=kas \
  --set controlPlane.sandboxManager.profiles.standard.namespace=elsewhere
expect_fail "managed settings without profiles" --set registrationToken.value=x \
  --set controlPlane.sandboxManager.defaultProfile=standard
expect_fail "a startup setting under sandboxManager" --set registrationToken.value=x \
  --set controlPlane.sandboxManager.profiles.standard.backend=kas \
  --set controlPlane.sandboxManager.workspace=/tmp/elsewhere
expect_fail "oidc without hostname" --set registrationToken.value=x --set oidc.enabled=true
# The profile matters: without one the pre-existing "needs at least one
# profile" validation fires first and the case proves nothing.
expect_fail "preview configured twice" --set registrationToken.value=x \
  --set controlPlane.sandboxManager.profiles.standard.backend=kas \
  --set preview.domain=sandbox.example.com \
  --set controlPlane.sandboxManager.preview.domain=other.com
expect_fail "LoadBalancer without the proxy" --set registrationToken.value=x \
  --set service.type=LoadBalancer

echo "--- :kubernetes: Rendering the sandbox pool"
kubectl kustomize deploy/kubernetes/runner >/tmp/kustomize-runner.yaml

# The sandbox pool is the only kustomize artifact; the control plane is the
# chart. The pool must stay usable as a remote base, so it owns nothing that
# belongs to the control plane — including its identity and permissions,
# which ship with the chart — and its template must read the two names the
# chart writes.
for expected in "kind: SandboxTemplate" "kind: SandboxWarmPool"; do
  grep -q "$expected" /tmp/kustomize-runner.yaml \
    || { echo "sandbox pool lost: $expected" >&2; exit 1; }
done
if grep -qE "kind: (Deployment|Service|PersistentVolumeClaim|Role|RoleBinding|ServiceAccount)$" \
  /tmp/kustomize-runner.yaml; then
  echo "sandbox pool owns resources that belong to the control plane" >&2; exit 1
fi
for expected in "dsh-yawn-runner-config" "dsh-yawn-registration-token" "dsh-yawn-universal"; do
  grep -q "$expected" /tmp/kustomize-runner.yaml \
    || { echo "sandbox pool lost its link to the control plane: $expected" >&2; exit 1; }
done

# The pool reads specific keys and the chart writes them. A key renamed on one
# side is invisible to the name checks above and fails only at runtime: a
# runner started without DSH_YAWN_REGISTRATION_TOKEN exits with
# "DSH_YAWN_REGISTRATION_TOKEN or DSH_YAWN_REGISTRATION_TOKEN_FILE is required",
# and the sandbox never registers.
for expected in "name: DSH_YAWN_CONTROL_PLANE_URL" "key: DSH_YAWN_CONTROL_PLANE_URL" \
  "name: DSH_YAWN_REGISTRATION_TOKEN" "key: token"; do
  grep -q "$expected" /tmp/kustomize-runner.yaml \
    || { echo "sandbox pool no longer reads: $expected" >&2; exit 1; }
done

# The tunnel egress rule selects the control-plane pod in the NetworkPolicy's
# own namespace. A namespaceSelector here would name one install's namespace,
# which the namespace transformer cannot rewrite, so every overlay outside
# `dsh-yawn` would have to patch the rule by list index. kube-system stays: DNS
# is cluster-wide.
grep -q "app.kubernetes.io/name: dsh-yawn-control-plane" /tmp/kustomize-runner.yaml \
  || { echo "sandbox pool no longer selects the control-plane pod" >&2; exit 1; }
grep -q "kubernetes.io/metadata.name: kube-system" /tmp/kustomize-runner.yaml \
  || { echo "sandbox pool lost its kube-dns egress rule" >&2; exit 1; }
if grep -qE "kubernetes.io/metadata.name: dsh-yawn$" /tmp/kustomize-runner.yaml; then
  echo "sandbox pool pins the tunnel egress rule to the dsh-yawn namespace" >&2; exit 1
fi

# The pool has to land in the control plane's namespace, so the base refuses to
# pick one: it carries a placeholder no cluster has, and an overlay's namespace
# has to replace it. Without both halves, a control plane installed outside dsh-yawn
# would claim sandboxes the pool never created.
grep -q "namespace: dsh-set-your-namespace" /tmp/kustomize-runner.yaml \
  || { echo "sandbox pool no longer requires an explicit namespace" >&2; exit 1; }
ns_overlay="$(mktemp -d "$PWD/.dsh-lint-namespace.XXXXXX")"
pin_overlay="$(mktemp -d "$PWD/.dsh-lint-pin.XXXXXX")"
config_overlay="$(mktemp -d "$PWD/.dsh-lint-config.XXXXXX")"
trap 'rm -rf "$ns_overlay" "$pin_overlay" "$config_overlay"' EXIT
cat >"$ns_overlay/kustomization.yaml" <<'EOF'
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
namespace: operator-ns
resources:
  - ../deploy/kubernetes/runner
EOF
kubectl kustomize "$ns_overlay" >/tmp/kustomize-runner-ns.yaml
grep -q "namespace: operator-ns" /tmp/kustomize-runner-ns.yaml \
  || { echo "sandbox pool namespace cannot be set by an overlay" >&2; exit 1; }
if grep -q "dsh-set-your-namespace" /tmp/kustomize-runner-ns.yaml; then
  echo "sandbox pool kept the namespace placeholder under an overlay" >&2; exit 1
fi

# The base names the runner image without a tag, because the version belongs to
# the operator's overlay. A release used to stamp a tag here and push the stamp
# commit to `main`, which the branch ruleset rejects, so no release can do that
# again. A tag reappearing in the base is that mistake returning.
if grep -qE "^[[:space:]]*newTag:" deploy/kubernetes/runner/kustomization.yaml; then
  echo "sandbox pool pins a runner tag: the overlay owns it" >&2; exit 1
fi
grep -q "image: ghcr.io/zhming0/dsh-yawn-runner\$" /tmp/kustomize-runner.yaml \
  || { echo "sandbox pool no longer names the runner image untagged" >&2; exit 1; }
cat >"$pin_overlay/kustomization.yaml" <<'EOF'
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
namespace: operator-ns
resources:
  - ../deploy/kubernetes/runner
images:
  - name: ghcr.io/zhming0/dsh-yawn-runner
    newTag: v9.9.9-test
EOF
kubectl kustomize "$pin_overlay" >/tmp/kustomize-runner-pin.yaml
grep -q "image: ghcr.io/zhming0/dsh-yawn-runner:v9.9.9-test" /tmp/kustomize-runner-pin.yaml \
  || { echo "an overlay cannot pin the runner image" >&2; exit 1; }

# An operator varies the pool without naming a list index: the workspace claim
# is replaced as a whole, pod resources are a map, and one egress rule is
# appended. This renders the recipes docs/installations-kas.md documents, so a
# re-vendor that moves or renames a list entry fails here instead of in an
# operator's overlay.
cat >"$config_overlay/kustomization.yaml" <<'EOF'
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
namespace: operator-ns
resources:
  - ../deploy/kubernetes/runner
images:
  - name: ghcr.io/zhming0/dsh-yawn-runner
    newTag: v9.9.9-test
patches:
  - target: { kind: SandboxWarmPool, name: dsh-yawn-universal }
    patch: |-
      - op: replace
        path: /spec/replicas
        value: 4
  - target: { kind: SandboxTemplate, name: dsh-yawn-universal }
    patch: |-
      - op: replace
        path: /spec/volumeClaimTemplates
        value:
          - metadata:
              name: workspace
            spec:
              accessModes: [ReadWriteOnce]
              storageClassName: rook-ceph-block
              resources:
                requests:
                  storage: 5Gi
      - op: add
        path: /spec/podTemplate/spec/resources
        value:
          requests: {cpu: 200m, memory: 512Mi}
          limits: {cpu: "4", memory: 6Gi}
      - op: add
        path: /spec/networkPolicy/egress/-
        value:
          to: [{ipBlock: {cidr: 10.0.0.0/8}}]
          ports: [{protocol: TCP, port: 8443}]
EOF
kubectl kustomize "$config_overlay" >/tmp/kustomize-runner-config.yaml
for expected in "replicas: 4" "storageClassName: rook-ceph-block" "storage: 5Gi" \
  "mountPath: /workspace" "memory: 6Gi" "cidr: 10.0.0.0/8"; do
  grep -q "$expected" /tmp/kustomize-runner-config.yaml \
    || { echo "operator configurability lost: $expected" >&2; exit 1; }
done

# The chart must render everything the pool reads, and the control plane's API
# access must cover the claims and sandboxes it operates.
for expected in "name: dsh-yawn-runner-config" "name: dsh-yawn-registration-token" \
  "name: dsh-yawn-control-plane" "kind: RoleBinding"; do
  grep -q "$expected" /tmp/chart-default.yaml \
    || { echo "chart does not render: $expected" >&2; exit 1; }
done
grep -q "^  DSH_YAWN_CONTROL_PLANE_URL:" /tmp/chart-default.yaml \
  || { echo "chart's runner config lost its DSH_YAWN_CONTROL_PLANE_URL key" >&2; exit 1; }
grep -q "^  token:" /tmp/chart-default.yaml \
  || { echo "chart's registration token Secret lost its token key" >&2; exit 1; }
for expected in "extensions.agents.x-k8s.io" "sandboxclaims" "agents.x-k8s.io" "sandboxes"; do
  grep -q "$expected" /tmp/chart-default.yaml \
    || { echo "chart's control-plane Role lost: $expected" >&2; exit 1; }
done

test -s /tmp/kustomize-runner.yaml || { echo "empty runner render" >&2; exit 1; }

echo "chart lint and render OK"
