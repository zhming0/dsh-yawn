{
  "name": "dsh-yawn-workspace",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "build": "pnpm --filter @zhming0/dsh-yawn build",
    "check": "pnpm proto:check && pnpm --filter @zhming0/dsh-yawn check",
    "format": "pnpm --filter @zhming0/dsh-yawn format",
    "format:check": "pnpm --filter @zhming0/dsh-yawn format:check",
    "lint": "pnpm --filter @zhming0/dsh-yawn lint && (cd runner && golangci-lint run)",
    "proto:check": "buf lint && buf format --diff --exit-code",
    "proto:generate": "buf generate",
    "test": "pnpm --filter @zhming0/dsh-yawn test",
    "test:docker": "node scripts/docker-smoke.mjs",
    "test:kas": "scripts/kas/e2e-test.sh"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.72.0",
    "@bufbuild/protoc-gen-es": "2.14.0"
  }
}
