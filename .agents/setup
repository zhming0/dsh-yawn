#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Node's built-in fetch ignores HTTP(S)_PROXY unless NODE_USE_ENV_PROXY is set.
# A proxied sandbox exports those variables, and this hook bootstraps pnpm
# through corepack, which uses fetch. An explicit value still wins.
export NODE_USE_ENV_PROXY="${NODE_USE_ENV_PROXY:-1}"

# Same bootstrap CI uses, so an agent and a build get identical tool versions.
source "${ROOT_DIR}/.buildkite/steps/lib/mise.bash"
ensure_tools

# Later shells in this sandbox get ~/.local/bin on PATH but not the mise shims
# directory, so link the shims across. Amp owns its gh wrapper; replacing it
# with a mise shim lets a later wrapper refresh overwrite the mise executable
# that every shim shares.
mkdir -p "$HOME/.local/bin"
shim_dir="${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims"
for shim in "$shim_dir/"*; do
  [[ "${shim##*/}" == "gh" ]] || ln -sf "$shim" "$HOME/.local/bin/"
done

pnpm install --frozen-lockfile
